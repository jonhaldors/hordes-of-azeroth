							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				this:SetBackdropColor(0, 0, 0, 0.55);
				this:SetBackdropBorderColor(0.6, 0.6, 0.6);
			</OnLoad>
		</Scripts>
	</Frame>

	<Button name="BonkCharRowTemplate" virtual="true">
		<Size>
			<AbsDimension x="300" y="56"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentSelected" file="Interface\Glues\CharacterSelect\Glue-CharacterSelect-Highlight" alphaMode="ADD" hidden="true">
					<Size>
						<AbsDimension x="340" y="74"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="-20" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" file="Interface\Glues\CharacterCreate\UI-CharacterCreate-Classes">
					<Size>
						<AbsDimension x="40" y="40"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="6" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentName" inherits="GlueFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT">
							<Offset>
								<AbsDimension x="10" y="-2"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentSub" inherits="GlueFontHighlightSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="0" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				getglobal(this:GetName().."Highlight"):SetAlpha(0.35);
				getglobal(this:GetName().."Selected"):SetAlpha(0.5);
			</OnLoad>
			<OnClick>
				BonkHero_SelectClass(this:GetID());
			</OnClick>
			<OnDoubleClick>
				BonkHero_Play();
			</OnDoubleClick>
		</Scripts>
		<HighlightTexture name="$parentHighlight" file="Interface\Glues\CharacterSelect\Glue-CharacterSelect-Highlight" alphaMode="ADD">
			<Size>
				<AbsDimension x="340" y="74"/>
			</Size>
			<Anchors>
				<Anchor point="LEFT">
					<Offset>
						<AbsDimension x="-20" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</HighlightTexture>
	</Button>

	<Frame name="BonkSpellRowTemplate" enableMouse="true" virtual="true">
