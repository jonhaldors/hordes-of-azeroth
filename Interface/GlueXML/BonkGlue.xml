	<Font name="BonkFontSoft" inherits="MasterFont" font="Fonts\FRIZQT__.TTF" virtual="true">
		<FontHeight>
			<AbsValue val="11"/>
		</FontHeight>
		<Color r="0.78" g="0.75" b="0.68"/>
	</Font>
	<Font name="BonkFontTiny" inherits="MasterFont" font="Fonts\FRIZQT__.TTF" virtual="true">
