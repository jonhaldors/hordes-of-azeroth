# Whitelist repo: everything is ignored unless explicitly un-ignored below.
# Base game files (WoW.exe, Data/*.MPQ, WTF/, WDB/, Logs/, ...) never get tracked.
/*

# Repo metadata
!/.gitignore
!/README.md
!/BUILDING.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/.github/
!/VERSION
!/CHANGELOG.md

# Addons: ours live here. The client writes Blizzard_*/ key files into the
# same folder on launch; those are game files.
!/Interface/
/Interface/*
!/Interface/AddOns/
/Interface/AddOns/Blizzard_*/
# Disabled test addons (renamed to .off) stay local.
/Interface/AddOns/*.off/
# Built from the player's own client art by TelegraphKit (tools/build-telegraphs.ps1).
/Interface/AddOns/HordesOfAzeroth/Textures/ClassCrests.tga
/Interface/AddOns/HordesOfAzeroth/Textures/PlayerFrameNoPower.tga

# Our login and hero screens. BonkAccount.lua holds the local login;
# mangosd writes BonkStats.lua.
!/Interface/GlueXML/
/Interface/GlueXML/BonkAccount.lua
/Interface/GlueXML/BonkStats.lua

# Local server tooling and settings.
!/tools/
/tools/telegraphs/bin/
/tools/launcher/bin/
/tools/launcher/obj/
!/config/
!/play.bat

!/stop.bat

# Translations of the server's text, edited with tools/translate.ps1.
!/localization/

# Under /server only the VMaNGOS fork (a submodule) is tracked. The build,
# MariaDB and extracted client data are generated or third-party.
!/.gitmodules
!/server/
/server/*
!/server/core

# The benilla client fork (a submodule).
!/client

# To track a new top-level project folder, add a line like:
# !/addon-src/

tools/bench/results.json

__pycache__/
