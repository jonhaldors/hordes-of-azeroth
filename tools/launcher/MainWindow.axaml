<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HordesOfAzeroth.Launcher.MainWindow"
        Title="Hordes of Azeroth"
        Width="1280" Height="752" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="avares://HoALauncher/art/icon.ico"
        Background="{StaticResource Background}"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True">
    <Grid RowDefinitions="*,Auto">
        <Grid ClipToBounds="True">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="60%,55%" GradientOrigin="60%,55%" RadiusX="80%" RadiusY="90%">
                        <GradientStop Color="#5A1E10" Offset="0" />
                        <GradientStop Color="#2A0F0B" Offset="0.55" />
                        <GradientStop Color="#110C0C" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image x:Name="Art" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#B8000000" Offset="0" />
                        <GradientStop Color="#1A000000" Offset="0.42" />
                        <GradientStop Color="#1A000000" Offset="0.6" />
                        <GradientStop Color="#99000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel Margin="36,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="TitleText" Text="Hordes of Azeroth" FontSize="46" Foreground="#FFD100">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" OffsetX="1.4" OffsetY="1.4" Opacity="0.95" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="Tagline" Text="Survive the horde. As long as you can." FontSize="13" Foreground="#EADBB4" Margin="4,2,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="2" OffsetX="0.7" OffsetY="0.7" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <Button x:Name="CoffeeButton" Theme="{StaticResource CoffeeButton}" Height="40" Margin="36,0,0,24"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Coffee_Click"
                    ToolTip.Tip="Support Hordes of Azeroth on Buy Me a Coffee">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#0D0C22" Data="M3,9 H17 V15 A5,5 0 0 1 12,20 H8 A5,5 0 0 1 3,15 Z" />
                            <Path Stroke="#0D0C22" StrokeThickness="2" Data="M17,11 H18.5 A2.5,2.5 0 0 1 18.5,16 H16.5" />
                            <Path Stroke="#0D0C22" StrokeThickness="1.6" StrokeLineCap="Round"
                                  Data="M7,3.5 V6 M10,2.5 V6 M13,3.5 V6" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Buy me a coffee" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Width="396" Margin="0,24,24,24" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <DockPanel MaxHeight="560">
                    <Border x:Name="NotesPager" DockPanel.Dock="Bottom" IsVisible="False"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <Grid Margin="8,4" ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="OlderNotes" Grid.Column="0" Theme="{StaticResource PagerButton}" Click="OlderNotes_Click"
                                    Content="‹  Older" ToolTip.Tip="Earlier patch notes" />
                            <TextBlock x:Name="NotePageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource Muted}" />
                            <Button x:Name="NewerNotes" Grid.Column="2" Theme="{StaticResource PagerButton}" Click="NewerNotes_Click"
                                    Content="Newer  ›" ToolTip.Tip="Later patch notes" />
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NotesPanel" Margin="20,18,20,18" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" MinHeight="104" Padding="0,0,0,14" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="36,20,36,0">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,7,7,0" IsVisible="False" VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusDetail" Grid.Column="2" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,2,0,0" TextWrapping="Wrap" VerticalAlignment="Top" />
                    </Grid>
                    <ProgressBar x:Name="Progress" Classes="thin" Opacity="0" Margin="0,11,0,0" HorizontalAlignment="Stretch" Minimum="0" Maximum="1" Value="0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock x:Name="InstalledText" FontSize="12" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource Muted}" />
                        <Button Theme="{StaticResource BarLink}" Content="Check for updates" Click="CheckForUpdates_Click" />
                        <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource Muted}" />
                        <Button Theme="{StaticResource BarLink}" Content="Open game folder" Click="OpenGameFolder_Click" />
                        <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource Muted}" />
                        <Button Theme="{StaticResource BarLink}" Content="Report a bug" Click="ReportBug_Click"
                                ToolTip.Tip="Saves a zip of your logs and opens the bug report form. Attach the zip to your report." />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,22,36,0" VerticalAlignment="Top">
                    <Button x:Name="LanguageButton" Theme="{StaticResource LanguageLink}" Margin="0,0,16,0" VerticalAlignment="Center"
                            Click="LanguageButton_Click" ToolTip.Tip="The language the game shows its text in">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="LanguageMenu" Placement="TopEdgeAlignedLeft" />
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="AccountButton" Theme="{StaticResource AccountPill}" Margin="0,0,14,0" VerticalAlignment="Center"
                            Click="AccountButton_Click" ToolTip.Tip="The account you play as. Each account has its own characters, gold and unlocks.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border x:Name="AccountBadge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}">
                                <TextBlock x:Name="AccountInitial" FontSize="10" FontWeight="Bold" Foreground="#1A0F0D"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="AccountName" FontSize="13" VerticalAlignment="Center" />
                            <Path Data="M0,5 L8,5 L4,0 Z" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AccountMenu" Placement="TopEdgeAlignedLeft" />
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="DiscordButton" Theme="{StaticResource DiscordButton}" Width="58" Height="58" Margin="0,0,10,0" Click="Discord_Click" ToolTip.Tip="Join the Hordes of Azeroth Discord">
                        <Viewbox Width="28" Height="28">
                            <Path Fill="White" Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="PrimaryButton" Theme="{StaticResource PrimaryButton}" Width="250" Height="58" Content="Play" Click="PrimaryButton_Click" />
                    <Button x:Name="MoreButton" Theme="{StaticResource MoreButton}" Width="46" Height="58" Margin="6,0,0,0" Click="MoreButton_Click">
                        <Canvas Width="20" Height="4">
                            <Ellipse Width="4" Height="4" Canvas.Left="0" Fill="{StaticResource Text}" />
                            <Ellipse Width="4" Height="4" Canvas.Left="8" Fill="{StaticResource Text}" />
                            <Ellipse Width="4" Height="4" Canvas.Left="16" Fill="{StaticResource Text}" />
                        </Canvas>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OptionsMenu" Placement="TopEdgeAlignedRight" Opened="OptionsMenu_Opened">
                                <MenuItem x:Name="BuildItem" ToggleType="CheckBox" Header="Build monster paths while I play" Click="BuildItem_Click" />
                                <MenuItem Header="Monster path build speed…" Click="BuildSpeedItem_Click" />
                                <MenuItem x:Name="TrayItem" ToggleType="CheckBox" Header="Keep running in the tray" Click="TrayItem_Click" />
                                <MenuItem x:Name="RunDataItem" ToggleType="CheckBox" Header="Send run data to help balance the game" Click="RunDataItem_Click"
                                          ToolTip.Tip="After each run, sends your build, picks, boss times and how the run ended. No names, chat or files." />
                                <MenuItem x:Name="CrashReportItem" ToggleType="CheckBox" Header="Offer to send crash reports" Click="CrashReportItem_Click"
                                          ToolTip.Tip="After the game, its server or the launcher crashes, asks whether to send the logs and gives you a reference for your bug report." />
                                <Separator />
                                <MenuItem x:Name="BackupItem" Header="Back up my save data…" Click="BackupItem_Click"
                                          ToolTip.Tip="Saves the characters, gold, unlocks and settings of every account into one file." />
                                <MenuItem x:Name="RestoreItem" Header="Restore a backup…" Click="RestoreItem_Click" />
                                <Separator />
                                <MenuItem x:Name="RepairItem" Header="Repair the game…" Click="RepairItem_Click"
                                          ToolTip.Tip="Checks every game file, puts back the ones that are missing or damaged and reloads the world. Your characters and unlocks stay." />
                                <MenuItem Header="Open AddOns folder" Click="OpenAddOns_Click"
                                          ToolTip.Tip="Put your own addons here, one folder each. The Hordes of Azeroth addon in this folder is replaced at every start." />
                                <MenuItem Header="Open logs folder" Click="OpenLogs_Click" />
                                <MenuItem Header="Save logs" Click="SaveLogs_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
