<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="BonkGluePad.lua"/>
	<Frame name="BonkPadSlotTemplate" virtual="true" hidden="true">
		<Size>
			<AbsDimension x="1" y="34"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentGlyph" file="Interface\AddOns\HordesOfAzeroth\Textures\ControllerGlyphs">
					<Size>
						<AbsDimension x="24" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
				<Texture name="$parentGlyph2" file="Interface\AddOns\HordesOfAzeroth\Textures\ControllerGlyphs" hidden="true">
					<Size>
						<AbsDimension x="24" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentGlyph" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="2" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentLabel" inherits="GlueFontHighlight" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentGlyph" relativePoint="RIGHT">
							<Offset>
								<AbsDimension x="5" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="BonkPadFrame" parent="GlueParent" frameStrata="DIALOG" hidden="true">
		<Size>
			<AbsDimension x="1" y="34"/>
		</Size>
		<Anchors>
			<Anchor point="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="-10" y="5"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentShade" file="Interface\AddOns\HordesOfAzeroth\Textures\CornerShade">
					<Size>
						<AbsDimension x="460" y="120"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeTo="GlueParent"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="BonkPadSlot1" inherits="BonkPadSlotTemplate"/>
			<Frame name="BonkPadSlot2" inherits="BonkPadSlotTemplate"/>
			<Frame name="BonkPadSlot3" inherits="BonkPadSlotTemplate"/>
			<Frame name="BonkPadSlot4" inherits="BonkPadSlotTemplate"/>
			<Frame name="BonkPadSlot5" inherits="BonkPadSlotTemplate"/>
			<Frame name="BonkPadSlot6" inherits="BonkPadSlotTemplate"/>
			<Frame name="BonkPadSlot7" inherits="BonkPadSlotTemplate"/>
		</Frames>
	</Frame>
	<Frame name="BonkPadDriver" parent="GlueParent">
		<Scripts>
			<OnUpdate>
				BonkPad_OnUpdate(arg1);
			</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
