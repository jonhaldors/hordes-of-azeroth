<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HordesOfAzeroth.Launcher.BuildSpeedWindow"
        Title="hoa.launcher.monster_paths"
        Width="560" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://HoALauncher/art/icon.ico"
        Background="{StaticResource Bar}"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True">
    <StackPanel Margin="28,22,28,24">
        <TextBlock Text="hoa.launcher.before_the_build_starts" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
        <TextBlock Text="hoa.launcher.how_hard_should_your_pc_work" FontSize="20" FontWeight="Bold" Margin="0,4,0,10" />
        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Margin="0,0,0,8"
                   Text="hoa.launcher.the_launcher_now_works_out_where_monsters_can_walk_in_every_" />
        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,0,0,16"
                   Text="hoa.launcher.this_is_heavy_work_your_processor_can_sit_at_100_and_your_fa" />

        <TextBlock Text="hoa.launcher.first_zones_before_you_can_play" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
        <UniformGrid Columns="2" Margin="0,0,0,16">
            <RadioButton x:Name="InstallAll" GroupName="hoa.launcher.install" Theme="{StaticResource ChoiceCard}" Margin="0,0,5,0" />
            <RadioButton x:Name="InstallHalf" GroupName="hoa.launcher.install" Theme="{StaticResource ChoiceCard}" Margin="5,0,0,0" />
        </UniformGrid>

        <TextBlock Text="hoa.launcher.harder_zones_in_the_background_afterwards" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
        <UniformGrid Columns="2" Margin="0,0,0,8">
            <RadioButton x:Name="BackgroundAll" GroupName="Background" Theme="{StaticResource ChoiceCard}" Margin="0,0,5,0" />
            <RadioButton x:Name="BackgroundHalf" GroupName="Background" Theme="{StaticResource ChoiceCard}" Margin="5,0,0,0" />
        </UniformGrid>
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,18"
                   Text="hoa.launcher.you_can_change_these_settings_any_time_from_the_menu_next_to" />

        <Button Theme="{StaticResource PrimaryButton}" Content="hoa.launcher.continue" FontSize="16" Height="42" Width="180"
                HorizontalAlignment="Right" IsDefault="True" Click="Continue_Click" />
    </StackPanel>
</Window>
